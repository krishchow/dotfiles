# direnv: keep the private secrets/ submodule in sync on entering the repo.
# Non-fatal throughout — a machine without access to the private repo just skips it.

if [[ ! -e secrets/.git ]]; then
    # First entry on this machine: clone + check out the pinned commit.
    git submodule update --init secrets >&2 || log_error "secrets/: submodule init failed (no access?) — skipping"
elif [[ -z "$(git -C secrets status --porcelain 2>/dev/null)" ]] \
    && git -C secrets symbolic-ref -q HEAD >/dev/null; then
    # Clean and on a branch: fast-forward to the latest upstream. Local edits or
    # a detached HEAD are left alone so nothing in progress gets clobbered.
    git -C secrets pull --ff-only --quiet >&2 || log_error "secrets/: pull failed — leaving as-is"
else
    log_status "secrets/: local changes or detached HEAD — not syncing"
fi
