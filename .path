# Python
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

export PATH="$PATH:$HOME/Library/Python/3.9/bin"

# Java
[[ -n "${JAVA_HOME:-}" ]] && export PATH="$JAVA_HOME/bin:$PATH"

# Node
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# pnpm — the global bin dir moved between majors: pnpm 10 installs shims into
# $PNPM_HOME, pnpm 11 into $PNPM_HOME/bin. Homebrew pnpm (10.x) and the
# pnpm-managed one (11.x) both run on this machine, so put both on PATH.
for _pnpm_bin in "$PNPM_HOME" "$PNPM_HOME/bin"; do
  case ":$PATH:" in
    *":$_pnpm_bin:"*) ;;
    *) export PATH="$_pnpm_bin:$PATH" ;;
  esac
done
unset _pnpm_bin

# Google Cloud SDK
export PATH="/opt/homebrew/share/google-cloud-sdk/bin:$PATH"

# Maestro
export PATH="$PATH:$HOME/.maestro/bin"

# User-local binaries
export PATH="$PATH:$HOME/.local/bin"

# Dotfiles scripts
export PATH="$PATH:$DOTFILES/scripts"

# --- deepfreeze: migrated from /Users/krish/.zshenv on 2026-08-16 ---
# Ensure Homebrew/Docker CLI is on PATH for non-interactive shells (e.g. `ssh host docker …`).
# Added to let Anchor's integration tests reach Docker over ssh://localhost. Safe to remove.
export PATH="/usr/local/bin:$PATH"
